# Cloudflare account ID from the R2 overview page.
CLOUDFLARE_ACCOUNT_ID=

# R2 S3 API token credentials with Object Read & Write permission limited to
# the bucket below. Never commit the filled .env.r2 file.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Create this bucket in R2 Standard storage and bind it to THUMBNAILS.
R2_BUCKET_NAME=site-creator-r2

# Optional override. Normally derived from CLOUDFLARE_ACCOUNT_ID.
R2_ENDPOINT=
