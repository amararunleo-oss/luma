{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "predb:migrate:local": "node scripts/catalog/prepare-local-wrangler.mjs",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local --persist-to .wrangler/state --config dist/server/wrangler.json",
    "db:seed:build": "node scripts/catalog/build-seed-sql.mjs",
    "db:seed:local": "wrangler d1 execute site-creator-d1 --local --persist-to .wrangler/state --config dist/server/wrangler.json --file db/seeds/0000_sample.sql",
    "preview:worker": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "media:download": "node scripts/download-authorized-media.mjs",
    "catalog:import": "node scripts/import-videocelebs-catalog.mjs",
    "catalog:import:all": "node scripts/run-videocelebs-pipeline.mjs",
    "catalog:rankings:import": "node scripts/run-videocelebs-rankings.mjs",
    "catalog:metadata:repair": "node scripts/catalog/repair-title-taxonomy.mjs",
    "catalog:parallel:prepare": "node scripts/catalog/prepare-parallel-import.mjs",
    "catalog:parallel:worker": "node scripts/catalog/run-parallel-worker.mjs",
    "catalog:parallel:status": "node scripts/catalog/parallel-import-status.mjs",
    "catalog:parallel:merge": "node scripts/catalog/merge-parallel-import.mjs",
    "catalog:thumbnails:repair": "node scripts/catalog/repair-thumbnail-fallbacks.mjs",
    "r2:thumbnails:plan": "node scripts/catalog/upload-previews-r2.mjs",
    "r2:thumbnails:upload": "node scripts/catalog/upload-previews-r2.mjs --execute",
    "r2:thumbnails:verify": "node scripts/catalog/upload-previews-r2.mjs --verify",
    "catalog:db:build": "node scripts/catalog/build-staging-sql.mjs",
    "catalog:sync:local": "npm run catalog:db:build && wrangler d1 execute site-creator-d1 --local --persist-to .wrangler/state --config dist/server/wrangler.json --file data/staging/videocelebs/local-sync.sql"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
