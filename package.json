{
  "name": "actrexx",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "node scripts/check-production-env.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local --persist-to .wrangler/state",
    "db:seed:build": "node scripts/catalog/build-seed-sql.mjs",
    "db:seed:local": "wrangler d1 execute site-creator-d1 --local --persist-to .wrangler/state --file db/seeds/0000_sample.sql",
    "media:download": "node scripts/download-authorized-media.mjs",
    "catalog:import": "node scripts/import-videocelebs-catalog.mjs",
    "catalog:import:all": "node scripts/run-videocelebs-pipeline.mjs",
    "catalog:rankings:import": "node scripts/run-videocelebs-rankings.mjs",
    "catalog:metadata:repair": "node scripts/catalog/repair-title-taxonomy.mjs",
    "catalog:parallel:prepare": "node scripts/catalog/prepare-parallel-import.mjs",
    "catalog:parallel:worker": "node scripts/catalog/run-parallel-worker.mjs",
    "catalog:parallel:status": "node scripts/catalog/parallel-import-status.mjs",
    "catalog:parallel:merge": "node scripts/catalog/merge-parallel-import.mjs",
    "catalog:thumbnails:repair": "node scripts/catalog/repair-thumbnail-fallbacks.mjs",
    "r2:thumbnails:plan": "node scripts/catalog/upload-previews-r2.mjs",
    "r2:thumbnails:upload": "node scripts/catalog/upload-previews-r2.mjs --execute",
    "r2:thumbnails:verify": "node scripts/catalog/upload-previews-r2.mjs --verify",
    "catalog:db:build": "node scripts/catalog/build-staging-sql.mjs",
    "catalog:sync:local": "npm run catalog:db:build && wrangler d1 execute site-creator-d1 --local --persist-to .wrangler/state --file data/staging/videocelebs/local-sync.sql",
    "seo:indexnow": "node scripts/search/submit-indexnow.mjs",
    "seo:audit": "node scripts/search/audit-catalog-seo.mjs",
    "ads:check": "node scripts/ads/check-exoclick.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@dailymotion/vast-client": "^6.4.5",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.30.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
