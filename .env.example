# Public site origin used after a domain is connected.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_MEDIA_BASE_URL=

# Search engine ownership and incremental URL notification.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
INDEXNOW_KEY=

# ExoClick async banner zones. Copy both values from each generated zone snippet.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_EXOCLICK_BLOCK_AD_TYPES=
NEXT_PUBLIC_EXOCLICK_CATALOG_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_CATALOG_CLASS=
NEXT_PUBLIC_EXOCLICK_CATALOG_MOBILE_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_CATALOG_MOBILE_CLASS=
NEXT_PUBLIC_EXOCLICK_SIDEBAR_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_SIDEBAR_CLASS=
NEXT_PUBLIC_EXOCLICK_PLAYER_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_PLAYER_CLASS=
NEXT_PUBLIC_EXOCLICK_PLAYER_MOBILE_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_PLAYER_MOBILE_CLASS=
NEXT_PUBLIC_EXOCLICK_OUTSTREAM_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_OUTSTREAM_CLASS=
NEXT_PUBLIC_EXOCLICK_STICKY_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_STICKY_CLASS=
NEXT_PUBLIC_EXOCLICK_INSTANT_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_INSTANT_CLASS=
NEXT_PUBLIC_EXOCLICK_VIDEO_SLIDER_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_VIDEO_SLIDER_CLASS=
NEXT_PUBLIC_EXOCLICK_DESKTOP_FPI_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_DESKTOP_FPI_CLASS=
NEXT_PUBLIC_EXOCLICK_MOBILE_FPI_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_MOBILE_FPI_CLASS=
NEXT_PUBLIC_EXOCLICK_MOBILE_INSTANT_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_MOBILE_INSTANT_CLASS=
NEXT_PUBLIC_EXOCLICK_DRAWER_MOBILE_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_DRAWER_MOBILE_CLASS=
NEXT_PUBLIC_EXOCLICK_SEARCH_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_SEARCH_CLASS=
NEXT_PUBLIC_EXOCLICK_SEARCH_MOBILE_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_SEARCH_MOBILE_CLASS=
NEXT_PUBLIC_EXOCLICK_MOBILE_POPUNDER_ZONE_ID=
NEXT_PUBLIC_EXOCLICK_MOBILE_POPUNDER_FREQUENCY_PERIOD=
NEXT_PUBLIC_EXOCLICK_MOBILE_POPUNDER_FREQUENCY_COUNT=

# Authorized-seller lines for /ads.txt. Separate multiple lines with \n.
ADS_TXT=

# Required operator details before public launch.
SITE_LEGAL_NAME=
SITE_CONTACT_EMAIL=
SITE_DMCA_EMAIL=
SITE_DMCA_ADDRESS=

# HTTP Basic credentials protecting the private /admin operations console.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random value used to pseudonymize report rate-limit identifiers.
REPORT_RATE_SALT=

# Optional bearer secret for a future scheduled health-check trigger.
MONITOR_SECRET=

# Cloudflare D1 REST and R2 S3 settings used by the Vercel server runtime.
# Prefer narrowly scoped tokens and keep real values in ignored env files.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=site-creator-r2
R2_ENDPOINT=

# Optional server-side catalog cache. Bump the version after a catalog refresh.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CATALOG_CACHE_VERSION=v1
